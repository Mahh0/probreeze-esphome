# Copier ce fichier en `secrets.yaml` et remplir les valeurs.
#   cp secrets.yaml.example secrets.yaml
# Le fichier reel est exclu par .gitignore.

# Reseau WiFi 2.4 GHz (l'ESP32-C3 ne voit pas la bande 5 GHz)
wifi_ssid: "MON_SSID_24GHZ"
wifi_password: "MON_MOT_DE_PASSE"

# Point d'acces de secours si le WiFi est injoignable
wifi_ap_password: "probreeze-setup"

# Cle de chiffrement de l'API ESPHome (base64, 32 octets)
# Generer :  python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
api_key: "REMPLACER_PAR_BASE64_32_OCTETS"

# Mot de passe des mises a jour OTA
# Generer :  python3 -c "import secrets;print(secrets.token_urlsafe(18))"
ota_password: "REMPLACER_PAR_UN_MOT_DE_PASSE"
